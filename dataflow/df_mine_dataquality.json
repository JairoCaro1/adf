{
	"name": "df_mine_dataquality",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText4",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DelimitedText3",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ID as string,",
				"          Number as string,",
				"          Parts as string,",
				"          Cost as string,",
				"          MfgYear as integer,",
				"          MfgDate as string,",
				"          Deprecated as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 split(isNull(Parts),",
				"     MfgYear> 2015,",
				"     disjoint: true) ~> split1@(errornullpart, errormgyear, DataQuality)",
				"split1@errornullpart sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ProductModelID as string,",
				"          Name as string",
				"     ),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}